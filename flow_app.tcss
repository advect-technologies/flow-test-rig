/* flow_app.tcss */

Screen {
  align: center middle;
  background: $surface;
}

.panel {
  border: solid $primary;
  background: $surface;
  padding: 1 2;
  margin: 1;
  height: auto;
}

TabbedContent {
  height: 1fr;
}

TabPane {
  padding: 1;
  height: 1fr;
}

/* ====================== LIVE TAB ====================== */
#metrics-table {
  height: 1fr;
  width: 1fr;
}

/* ====================== CONTROL TAB ====================== */
#metadata-panel, #control-panel {
  width: 50%;
  min-width: 38;
  height: 1fr;
}

#button-bar {
  height: auto;
  min-height: 4;
  align: center middle;
  margin-top: 1;
}

Input, Select {
  margin-bottom: 1;
  width: 100%;
}

Label {
  margin-top: 1;
  text-style: bold;
  color: $text;
}

.h2 {
  text-style: bold;
  color: $accent;
  margin-bottom: 1;
}

Button {
  margin: 0 1;
  min-width: 18;
}

Button#start_test {
  background: $success;
  color: $text;
}
Button#stop_test {
  background: $error;
  color: $text;
}

Static.h2 {
  dock: top;
  text-align: center;
}

/* Status Banner */
#status-banner {
  height: 3;
  padding: 1;
  text-align: center;
  text-style: bold;
  margin-bottom: 1;
}

/* State-based styling via classes */
#status-banner.status-idle {
  background: $success;
  color: $text;
}

#status-banner.status-running {
  background: $warning;
  color: $text;
}

#status-banner.status-fault {
  background: $error;
  color: $text;
}

#protocol-label {
  background: $boost;
  padding: 1;
  margin-bottom: 1;
  text-style: italic;
}

#protocol-select {
  margin-bottom: 1;
  width: 100%;
}

#metadata-panel Input, #metadata-panel Select {
  width: 100%;
}