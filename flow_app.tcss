/* flow_app.tcss */

Screen {
  align: center middle;
  background: $surface;
}

.panel {
  border: round $primary;
  background: $surface;
  padding: 1 1;
  margin: 1;
  height: 1fr;
}

.box {
    /* border: solid green; */
    border-bottom: double $primary;
    height: auto;
    margin: 1;
}

TabbedContent {
  height: 1fr;
  }
  
 
TabPane {
  padding: 1;
  /* height: 1fr; */
}

/* #metrics-box {
  height: 50%;
  width: 1fr;
  background: slategray;
  } */

#metrics-table {
  height: 1fr;
  width: 1fr;
  }
  
#metadata-panel, #control-panel {
    width: 50%;
    min-width: 38;
    height: 1fr;
    }
    
#button-bar {
  height: auto;
  min-height: 4;
  align: center middle;
  margin-top: 1;
  }
      
Input, Select {
  margin-bottom: 1;
  width: auto;
  height: auto;
  }
  
Input#notes {
  width: auto;
  max-width:50%;
  height: auto;
  }
  
Label {
  margin-top: 1;
  text-style: bold;
  color: $text;
  /* align-horizontal: center; */
  }
  
.h2 {
  text-style: bold;
  color: $accent;
  margin-bottom: 1;
  }
  
Button {
  margin: 0 1;
  min-width: 18;
  }


Button#start_test {
  background: $success;
  color: $text;
}

Button#stop_test {
  background: $error;
  color: $text;
}


Static.h2 {
  dock: top;
  text-align: center;
}


#status-banner {
  height: 3;
  padding: 1;
  text-align: center;
  text-style: bold;
  margin-bottom: 1;
}

#status-banner.status-idle {
  background: $success;
  color: $text;
}

#status-banner.status-running {
  background: $warning;
  color: $text;
}

#status-banner.status-fault {
  background: $error;
  color: $text;
}

#protocol-select {
  margin-bottom: 1;
  width: 75%;
}

#progress-display {
  height: auto;
  min-height: 7;
  padding: 1 2;
  /* background: $boost; */
  border: double $primary;
  text-style: bold;
}

#test-progress-bar {
  margin-top: 1;
  height: 4;
  /* border: vkey $primary; */
  background: $boost 10%;
}

Bar > .bar--bar {
    color: $success;
    background: $primary 30%;
}

Bar > .bar--complete {
    color: $success;
}
